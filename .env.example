# Sample model ids. Set GEN_AI_MODEL to an id the provider you type can call:
#   google:    gemini-flash-lite-latest
#   openai:    gpt-5.2
#   anthropic: claude-opus-5-5
GEN_AI_MODEL=your_model_id_here

# API key for whichever provider you choose at startup.
GEN_AI_API_KEY=your_api_key_here

# Optional sampling. Leave temperature and top_p unset to use the vendor default.
# GEN_AI_TEMPERATURE=0.7
# GEN_AI_TOP_P=0.95
# GEN_AI_MAX_TOKENS=4096
